# Server
PORT=3000

# Meta WhatsApp Cloud API
# Verify token you choose yourself and enter into the Meta App dashboard's
# webhook configuration screen (GET /webhook verification handshake).
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# System user access token from the Meta App dashboard (Bearer token used to
# call the Graph API to send messages).
WHATSAPP_ACCESS_TOKEN=change-me-access-token
# The "Phone Number ID" (not the phone number itself) from the Meta App
# dashboard's WhatsApp > API Setup screen.
WHATSAPP_PHONE_NUMBER_ID=change-me-phone-number-id
# App Secret from the Meta App dashboard, used to verify the
# X-Hub-Signature-256 header on inbound POST /webhook requests.
# REQUIRED -- the server refuses to start without this set. Without
# signature verification, anyone who finds the webhook URL could post fake
# WhatsApp events. NOTE: this env var was not in the original task's
# example list but is required by the technical design's
# signature-verification requirement (Phase L / Data Flow) -- see README
# "Judgment calls" section.
WHATSAPP_APP_SECRET=change-me-app-secret

# Dashboard session auth (single owner, no user table)
SESSION_SECRET=change-me-session-secret
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-owner-password

# SQLite file location (relative to app/ or absolute path)
DATABASE_PATH=./data/leads.db
