<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rimba Apparel — Failed Events</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f6f5f2; margin: 0; color: #2b2b2b; }
    header { background: #2b2b2b; color: #fff; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    header h1 { font-size: 1.1rem; margin: 0; }
    header form { margin: 0; }
    header button { background: transparent; border: 1px solid #777; color: #fff; padding: 0.4rem 0.8rem; border-radius: 6px; cursor: pointer; }
    main { max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
    .empty-state { background: #fff; padding: 3rem 2rem; text-align: center; border-radius: 12px; color: #666; }
    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 6px rgba(0,0,0,0.06); }
    th, td { text-align: left; padding: 0.8rem 1rem; border-bottom: 1px solid #eee; font-size: 0.92rem; vertical-align: top; }
    th { background: #faf9f7; font-weight: 600; color: #555; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; background: #ffe4e4; color: #b3261e; }
    .error-message { color: #444; }
    details.payload summary { cursor: pointer; color: #0b5fb0; font-size: 0.82rem; }
    details.payload pre { white-space: pre-wrap; word-break: break-word; font-size: 0.8rem; background: #faf9f7; padding: 0.6rem; border-radius: 6px; margin-top: 0.4rem; }
  </style>
</head>
<body>
  <header>
    <h1>Rimba Apparel — Failed Events</h1>
    <form method="POST" action="/logout">
      <button type="submit">Log out</button>
    </form>
  </header>
  <%- include('partials/nav', { activeNav: 'failed-events' }) %>
  <main>
    <% if (events.length === 0) { %>
      <div class="empty-state">
        <p><strong>No failed events</strong></p>
        <p>Nothing has failed to process yet -- webhook/Baileys errors will show up here when they happen.</p>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Channel</th>
            <th>Error</th>
            <th>Occurred at</th>
            <th>Raw payload</th>
          </tr>
        </thead>
        <tbody>
          <% events.forEach(function(event) { %>
            <tr>
              <td><span class="badge"><%= event.channel %></span></td>
              <td class="error-message"><%= event.error_message %></td>
              <td><%= new Date(event.occurred_at).toLocaleString() %></td>
              <td>
                <details class="payload">
                  <summary>View payload</summary>
                  <pre><%= event.raw_payload %></pre>
                </details>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
