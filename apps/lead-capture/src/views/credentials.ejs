<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rimba Apparel — Connector Credentials</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f6f5f2; margin: 0; color: #2b2b2b; }
    header { background: #2b2b2b; color: #fff; padding: 1rem 1.5rem; }
    header h1 { font-size: 1.1rem; margin: 0; }
    main { max-width: 560px; margin: 2rem auto; padding: 0 1rem; }
    .card { background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 1px 6px rgba(0,0,0,0.06); margin-bottom: 1.5rem; }
    .card h2 { margin-top: 0; font-size: 1rem; }
    .card p.hint { color: #666; font-size: 0.85rem; margin-top: -0.5rem; }
    .status-box { padding: 0.6rem 0.9rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.88rem; }
    .status-open { background: #eaf7ea; color: #1e7d1e; }
    label { display: block; font-size: 0.85rem; font-weight: 600; margin: 1rem 0 0.3rem; }
    label .set-badge { font-weight: 400; color: #1e7d1e; }
    label .unset-badge { font-weight: 400; color: #b3261e; }
    input[type="text"], input[type="password"] { width: 100%; box-sizing: border-box; padding: 0.5rem 0.7rem; border: 1px solid #ddd; border-radius: 6px; font-size: 0.92rem; }
    button { padding: 0.6rem 1.2rem; background: #2b2b2b; color: #fff; border: none; border-radius: 6px; font-size: 0.95rem; cursor: pointer; margin-top: 1.5rem; }
    button:hover { background: #444; }
    a.back-link { display: inline-block; margin-top: 0.5rem; color: #555; font-size: 0.9rem; }
  </style>
</head>
<body>
  <header>
    <h1>Rimba Apparel — Connector Credentials</h1>
  </header>
  <%- include('partials/nav', { activeNav: 'credentials' }) %>
  <main>
    <% if (saved) { %>
      <div class="status-box status-open">Saved.</div>
    <% } %>

    <form method="POST" action="/settings/credentials">
      <div class="card">
        <h2>WhatsApp Cloud API</h2>
        <p class="hint">Only used when the server is running in Cloud API mode (<code>WHATSAPP_MODE=cloud_api</code>). Get these from the Meta App dashboard's WhatsApp &gt; API Setup screen.</p>

        <label>Verify token <%= whatsappVerifyTokenSet ? '<span class="set-badge">(set)</span>' : '<span class="unset-badge">(not set)</span>' %></label>
        <input type="password" name="whatsappVerifyToken" placeholder="<%= whatsappVerifyTokenSet ? 'Leave blank to keep the current value' : 'Choose your own verify token' %>" autocomplete="off">

        <label>Access token <%= whatsappAccessTokenSet ? '<span class="set-badge">(set)</span>' : '<span class="unset-badge">(not set)</span>' %></label>
        <input type="password" name="whatsappAccessToken" placeholder="<%= whatsappAccessTokenSet ? 'Leave blank to keep the current value' : 'System user access token' %>" autocomplete="off">

        <label>Phone Number ID <%= whatsappPhoneNumberIdSet ? '<span class="set-badge">(set)</span>' : '<span class="unset-badge">(not set)</span>' %></label>
        <input type="text" name="whatsappPhoneNumberId" value="<%= whatsappPhoneNumberId || '' %>" placeholder="Phone Number ID (not the phone number itself)" autocomplete="off">

        <label>App secret <%= whatsappAppSecretSet ? '<span class="set-badge">(set)</span>' : '<span class="unset-badge">(not set)</span>' %></label>
        <input type="password" name="whatsappAppSecret" placeholder="<%= whatsappAppSecretSet ? 'Leave blank to keep the current value' : 'Required for webhook signature verification' %>" autocomplete="off">
      </div>

      <div class="card">
        <h2>Telegram</h2>
        <p class="hint">Get a token from <strong>@BotFather</strong> on Telegram. Leave unset to run WhatsApp-only.</p>

        <label>Bot token <%= telegramBotTokenSet ? '<span class="set-badge">(set)</span>' : '<span class="unset-badge">(not set)</span>' %></label>
        <input type="password" name="telegramBotToken" placeholder="<%= telegramBotTokenSet ? 'Leave blank to keep the current value' : 'Bot token from @BotFather' %>" autocomplete="off">
      </div>

      <button type="submit">Save credentials</button>
    </form>

    <p style="font-size: 0.82rem; color: #888;">
      Changes take effect on the next server restart (connectors are wired
      once at boot, same as <code>WHATSAPP_MODE</code>) — this page does not
      hot-reload an already-running connector.
    </p>

    <a class="back-link" href="/leads">&larr; Back to leads dashboard</a>
  </main>
</body>
</html>
