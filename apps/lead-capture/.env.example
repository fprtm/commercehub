# Server
# Distinct default per project (3001/3002/3003) so all three portfolio demo
# apps can run simultaneously on one machine without a port clash.
PORT=3001

# WhatsApp connector mode (FR-301): "cloud_api" (default, recommended) or
# "baileys". Chosen once at boot -- not switchable at runtime without a
# restart. See README.md "Dual WhatsApp mode" for the trade-off between the
# two before picking "baileys".
WHATSAPP_MODE=cloud_api

# Meta WhatsApp Cloud API credentials (verify token, access token, phone
# number ID, app secret) and the Telegram bot token moved out of `.env` and
# into the database as of 2026-09-03
# (docs/sdd/changes/2026-09-03-credentials-in-db.md) -- fill them in from the
# dashboard at /settings/credentials (after logging in) instead of here.
# They're the values an owner actually fills in themselves from a provider's
# dashboard (Meta App dashboard, @BotFather), unlike everything else in this
# file, which is bootstrap/infra config needed before the DB or the
# dashboard login even exist. A server restart is required after saving for
# the change to take effect (connectors are wired once at boot, same as
# WHATSAPP_MODE below -- not hot-reloaded).

# Dashboard session auth (single owner, no user table)
SESSION_SECRET=change-me-session-secret
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-owner-password

# SQLite file location (relative to app/ or absolute path)
DATABASE_PATH=./data/leads.db

# Fuzzy product matching (FR-501..FR-504). Optional -- overrides
# config/products.json's own "matchThreshold" field (which itself defaults
# to 0.65 if omitted there too). 0-1 scale; see
# src/services/productMatcher.js's doc comment for how the score is
# computed and why 0.65 was chosen. Edit config/products.json to manage the
# actual product catalog (name + optional aliases) -- see README.md
# "Configuring the product catalog".
# PRODUCT_MATCH_THRESHOLD=0.65

# Baileys session folder (FR-303). Only used when WHATSAPP_MODE=baileys.
# Local/gitignored -- this is paired-session state (WhatsApp Web-style
# credentials), not application data, so it does NOT live in the SQLite DB.
# Deleting this folder forces a fresh QR pairing on next start.
BAILEYS_AUTH_DIR=./data/baileys-auth
